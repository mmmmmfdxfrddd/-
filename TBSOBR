end

local FIXED_POS = Vector3.new(-748.2, 156.9, 463.9)

-- ============================================================
-- 开关1：传送6
-- ============================================================
local sixEnabled = false
local sixThread = nil
local cachedSix = {}

local TARGET_POSITIONS = {
    Vector3.new(-215.111328, 8.72383499, 758.315613),
    Vector3.new(-247.517181, 8.72381878, 740.978699),
    Vector3.new(-306.715302, 8.70365429, 745.686646),
    Vector3.new(-301.908691, 8.80608273, 671.83197),
    Vector3.new(-210.348557, 8.7238369, 633.625427),
    Vector3.new(-247.517181, 8.72213173, 647.015625),
    Vector3.new(-304.110016, 8.70365715, 636.541626)
}

local TOLERANCE = 1.0

local function isMatch(pos)
    for _, target in ipairs(TARGET_POSITIONS) do
        if (pos - target).Magnitude <= TOLERANCE then
            return true
        end
    end
    return false
end

local function scanAndCache()
    local ores = Workspace:FindFirstChild("Ores")
    if not ores then return 0 end

    local added = 0

    for _, obj in pairs(ores:GetDescendants()) do
        if not sixEnabled then break end

        if obj:IsA("BasePart") then
            if cachedSix[obj] then continue end

            if obj.Name == "6" and isMatch(obj.Position) then
                cachedSix[obj] = true
                added = added + 1
            end
        end
    end

    return added
end

local function teleportCached()
    local count = 0

    for part in pairs(cachedSix) do
        if part and part.Parent then
            pcall(function()
                part.CFrame = CFrame.new(FIXED_POS)
                part.Velocity = Vector3.new(0, 0, 0)
            end)
            count = count + 1
        else
            cachedSix[part] = nil
        end
    end

    return count
end

local function collectSix()
    local added = scanAndCache()
    local count = teleportCached()

    local total = 0
    for _ in pairs(cachedSix) do total = total + 1 end

    if count > 0 then
        statusLabel.Text = "✅ 缓存 " .. total .. " 个，传送中 (新+" .. added .. ")"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        statusLabel.Text = "⏳ 缓存 " .. total .. " 个，等待中..."
        statusLabel.TextColor3 = Color3.fromRGB(255, 255, 150)
    end
end

-- ============================================================
-- 开关2：定身旋转
-- ============================================================
local spinEnabled = false
local spinConnection = nil
local savedState = nil
local alignPos = nil
local attach0 = nil

local SPIN_SPEED = math.rad(360 * 1000)

local function lockPosition(hrp)
    savedState = {}
    savedState.position = hrp.Position

    attach0 = Instance.new("Attachment")
    attach0.Parent = hrp

    alignPos = Instance.new("AlignPosition")
    alignPos.Attachment0 = attach0
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.Position = savedState.position
    alignPos.MaxForce = math.huge
    alignPos.Responsiveness = 200
    alignPos.RigidityEnabled = true
    alignPos.Parent = hrp

    savedState.constraints = {}
    for _, obj in pairs(hrp:GetDescendants()) do
        if obj:IsA("BodyPosition")
        or obj:IsA("BodyVelocity")
        or obj:IsA("LinearVelocity") then
            savedState.constraints[obj] = obj.Enabled
            pcall(function() obj.Enabled = false end)
        end
    end

    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    if hum then
        savedState.autoRotate = hum.AutoRotate
        hum.AutoRotate = false
    end
end

local function unlockPosition(hrp)
    if not savedState then return end

    local hum = hrp and hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    if hum and savedState.autoRotate ~= nil then
        pcall(function() hum.AutoRotate = savedState.autoRotate end)
    end

    if savedState.constraints then
        for obj, enabled in pairs(savedState.constraints) do
            if obj and obj.Parent then
                pcall(function() obj.Enabled = enabled end)
            end
        end
    end

    if alignPos then pcall(function() alignPos:Destroy() end) alignPos = nil end
    if attach0 then pcall(function() attach0:Destroy() end) attach0 = nil end

    savedState = nil
end

local function startSpin()
    local char, hrp, hum = getChar()
    if not char or not hrp then
        statusLabel.Text = "❌ 找不到角色"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return false
    end

    pcall(function()
        hrp.CFrame = CFrame.new(FIXED_POS)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)

    task.wait(0.05)

    local c2, h2 = getChar()
    if h2 then
        lockPosition(h2)
    end

    spinEnabled = true

    if spinConnection then spinConnection:Disconnect() end
    spinConnection = RunService.Heartbeat:Connect(function(dt)
        if not spinEnabled then return end
        local c, h = getChar()
        if not h then return end

        local pos = h.Position
        h.CFrame = CFrame.new(pos) * (h.CFrame - pos) * CFrame.Angles(0, SPIN_SPEED * dt, 0)
    end)

    return true
end

local function stopSpin()
    spinEnabled = false
    if spinConnection then
        spinConnection:Disconnect()
        spinConnection = nil
    end
    local char, hrp = getChar()
    if hrp then
        unlockPosition(hrp)
    end
end

