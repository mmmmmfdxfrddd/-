-- ============================================================
-- 全局按名字找对象
-- ============================================================
local function findByName(name)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == name then
            return obj
        end
    end
    return nil
end

-- ============================================================
-- 按类型找 ClickDetector
-- ============================================================
local function findClickDetector(obj)
    for _, d in pairs(obj:GetDescendants()) do
        if d:IsA("ClickDetector") then
            return d
        end
    end
    return nil
end

-- ============================================================
-- 通用：全局找名字 → 检查位置 → 按类型找 ClickDetector → 触发
-- ============================================================
local function findAndClick(name, targetPos, tolerance)
    local obj = findByName(name)
    if not obj then
        return false, "找不到 " .. name
    end

    if targetPos then
        local pos = nil
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part then pos = part.Position end
        end

        if not pos then
            return false, name .. " 没有位置"
        end

        if (pos - targetPos).Magnitude > (tolerance or 5) then
            return false, name .. " 位置不匹配 (距离 " .. math.floor((pos - targetPos).Magnitude) .. ")"
        end
    end

    local cd = findClickDetector(obj)
    if not cd then
        return false, name .. " 找不到 ClickDetector"
    end

    pcall(function()
        fireclickdetector(cd)
    end)

    return true, "已触发 " .. name
end

