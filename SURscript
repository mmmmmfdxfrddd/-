local function useItem(itemName, char)
    local tool = LocalPlr.Backpack:FindFirstChild(itemName);
    if char:FindFirstChild(itemName) then
        char.Humanoid:UnequipTools();
        task.wait(0.1);
    end;
    if not tool then return false; end
    char.Humanoid:EquipTool(tool);
    task.wait(0.1);
    if char:FindFirstChild(itemName) then
        char[itemName]:Activate();
        fireRemote(RepStorage.Events.UseItem);
        local prompt = char[itemName]:FindFirstChildOfClass("ProximityPrompt");
        if prompt then fireproximityprompt(prompt, 1); end;
        task.wait(0.5);
        return true;
    end;
    return false;
end;

local function checkCondition()
    local currentStand = LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value or "None";
    local currentAttri = LocalPlr.Data and LocalPlr.Data.Attri and LocalPlr.Data.Attri.Value or "None";
    currentAttri = tostring(currentAttri);
    local hasStand = table.find(selectedStands, currentStand);
    local hasAttri = table.find(selectedAttris, currentAttri);
    
    if selectedCondition == "StandCheck" then return hasStand;
    elseif selectedCondition == "AttributeCheck" then return hasAttri;
    elseif selectedCondition == "StandOrAttriCheck" then return hasStand or hasAttri;
    elseif selectedCondition == "StandAndAttriCheck" then return hasStand and hasAttri;
    else return false; end;
end;

local function checkSpecialReserve()
    if not isSpecialReserveEnabled then return false; end
    local currentStand = LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value or "None";
    local currentAttri = LocalPlr.Data and LocalPlr.Data.Attri and LocalPlr.Data.Attri.Value or "None";
    currentAttri = tostring(currentAttri);
    
    for _, group in ipairs(specialReserveList) do
        if group.stand and group.stand ~= "" then
            if currentStand == group.stand then
                if group.attris and #group.attris > 0 then
                    for _, attri in ipairs(group.attris) do
                        if currentAttri == attri then
                            return true;
                        end;
                    end;
                else
                    return true;
                end;
            end;
        end;
    end;
    return false;
end;

local function unequipAll()
    local char = getChar();
    if char then
        char.Humanoid:UnequipTools();
        char.Humanoid.Sit = false;
    end;
end;

local function storeCurrentStand()
    local level = LocalPlr.Data and LocalPlr.Data.Level and LocalPlr.Data.Level.Value or 1;
    local hasGP1 = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(LocalPlr.UserId, 142794026); end) and true or false;
    local hasGP2 = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(LocalPlr.UserId, 146346514); end) and true or false;
    
    local slots = {1, 2, 4, 3, 5};
    if hasGP1 then table.insert(slots, 3); end;
    if level >= 120 then table.insert(slots, 4); end;
    if hasGP2 then table.insert(slots, 5); end;
    
    for _, slot in ipairs(slots) do
        local slotData = LocalPlr.Data["Slot" .. slot .. "Stand"];
        if slotData and slotData.Value == "None" then
            fireRemote(RepStorage.Events.SwitchStand, "Slot" .. slot);
            local timeout = tick() + 5;
            while tick() < timeout and LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value ~= "None" and isStandFarming do
                task.wait(0.1);
            end;
            if LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value == "None" then
                notify("提示", "已将替身存入栏位 " .. slot, 3);
                return true;
            else break; end;
        end;
    end;
    return false;
end;

local function doOneRoll()
    local char = getChar();
    if not char then return false, "no_character"; end
    
    local currentStand = LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value or "None";
    
    if currentStand ~= "None" and checkSpecialReserve() then
        if storeCurrentStand() then
            return true, "stored_special";
        else
            return false, "no_slots";
        end;
    end;
    
    if checkCondition() then
        if storeCurrentStand() then
            return true, "stored";
        else
            return false, "no_slots";
        end;
        
    elseif currentStand == "None" then
        if not useItem(selectedItem, char) then return false, "no_item"; end
        local timeout = tick() + 5;
        while tick() < timeout and LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value == "None" and isStandFarming do
            task.wait(0.1);
        end;
        return true, "used_item";
        
    elseif not useItem("Rokakaka", char) then
        return false, "no_rokakaka";
    else
        local timeout = tick() + 5;
        while tick() < timeout and LocalPlr.Data and LocalPlr.Data.Stand and LocalPlr.Data.Stand.Value ~= "None" and isStandFarming do
            task.wait(0.1);
        end;
        return true, "used_rokakaka";
    end;
end;

