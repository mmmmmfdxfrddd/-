local function clearLivingHumanoids()
    pcall(function()
        local living = l_Workspace_0:FindFirstChild("Living");
        if living then
            for _, obj in pairs(living:GetChildren()) do
                if obj:FindFirstChild("Humanoid") then
                    local hum = obj.Humanoid;
                    local parentName = hum.Parent and hum.Parent.Name or "";
                    if parentName ~= l_LocalPlayer_0.Name then
                        local isPlayer = false;
                        for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
                            if plr.Name == parentName then
                                isPlayer = true;
                                break;
                            end;
                        end;
                        if not isPlayer then
                            hum:Destroy();
                        end;
                    end;
                end;
            end;
        end;
    end);
end;

local function startDungeonLoop()
    clearLivingHumanoids();
    
    local char = getCharacter();
    if char then
        teleportPart(char.HumanoidRootPart, loadCFrame);
    end;
    task.wait(0.5);
    
    if eventConnection then eventConnection:Disconnect(); end;
    eventConnection = l_RunService_0.Heartbeat:Connect(function()
        if not isDungeonFarming then return; end;
        pcall(function()
            local npcs = l_Workspace_0.Map.NPCs:GetChildren();
            if npcs[41] and npcs[41]:FindFirstChild("Done") then
                npcs[41].Done:FireServer();
            end;
        end);
    end);
    
    task.wait(1);
    
    getgenv().G = true;
    getgenv().Creator = 'https://discord.gg/B3HqPPzFYr - HalloweenGaster';
    
    while getgenv().G and getgenv().Creator == 'https://discord.gg/B3HqPPzFYr - HalloweenGaster' and isDungeonFarming do
        local currentChar = getCharacter();
        if not currentChar or not currentChar:FindFirstChild("Humanoid") or currentChar.Humanoid.Health <= 0 then
            if not isWaitingRespawn then
                isWaitingRespawn = true;
                notify("警告", "角色已死亡，等待复活后重新开始...", 5);
            end;
            getgenv().G = false;
            if eventConnection then eventConnection:Disconnect(); end;
            repeat
                task.wait(1);
                currentChar = getCharacter();
            until currentChar and currentChar:FindFirstChild("Humanoid") and currentChar.Humanoid.Health > 0;
            
            isWaitingRespawn = false;
            notify("提示", "角色已复活，重新开始循环。", 3);
            startDungeonLoop();
            return;
        end;
        
        task.wait(0.9);
        pcall(function()
            sethiddenproperty(game.Players.LocalPlayer, "SimulationRadius", 112412400000);
            sethiddenproperty(game.Players.LocalPlayer, "MaxSimulationRadius", 112412400000);
        end);
        for _, d in pairs(game.Workspace:GetDescendants()) do
            if d.ClassName == "Humanoid" and d.Parent and d.Parent.Name ~= l_LocalPlayer_0.Name then
                local isPlayer = false;
                for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
                    if plr.Name == d.Parent.Name then
                        isPlayer = true;
                        break;
                    end;
                end;
                if not isPlayer then
                    d.Health = 0;
                end;
            end;
        end;
    end;
end;

