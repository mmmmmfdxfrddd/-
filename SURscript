local saveDataList = {};
local saveFileNames = {};
local autoLoadSaveEnabled = false;

local function refreshSaveList()
    saveDataList = {};
    saveFileNames = {};
    for i = 1, 50 do
        local fileName = "SUR_Save_" .. i .. ".json";
        pcall(function()
            local content = readfile(fileName);
            if content and content ~= "" then
                local data = game:GetService("HttpService"):JSONDecode(content);
                saveDataList[fileName] = data;
                table.insert(saveFileNames, "副本 " .. i);
            end;
        end);
    end;
    if #saveFileNames == 0 then
        saveFileNames = { "无存档" };
    end;
    if l_Options_0.SaveSelector then
        l_Options_0.SaveSelector:SetValues(saveFileNames);
        l_Options_0.SaveSelector:SetValue(saveFileNames[1] or "无存档");
    end;
end;

local function getCurrentSettings()
    local data = {
        selectedItem = selectedItem,
        selectedCondition = selectedCondition,
        selectedStands = {},
        selectedAttris = {},
        specialReserve = {},
        autoLoadSave = autoLoadSaveEnabled
    };
    for _, stand in ipairs(selectedStands) do
        table.insert(data.selectedStands, stand);
    end;
    for _, attri in ipairs(selectedAttris) do
        table.insert(data.selectedAttris, attri);
    end;
    for i = 1, 6 do
        local group = specialReserveList[i] or { stand = "", attris = {} };
        data.specialReserve[i] = {
            stand = group.stand or "",
            attris = {}
        };
        if group.attris then
            for _, attri in ipairs(group.attris) do
                table.insert(data.specialReserve[i].attris, attri);
            end;
        end;
    end;
    return data;
end;

local function applySettings(data)
    if data.selectedItem then
        selectedItem = data.selectedItem;
        l_Options_0.SelectItem:SetValue(data.selectedItem);
    end;
    if data.selectedCondition then
        selectedCondition = data.selectedCondition;
        l_Options_0.SelectCondition:SetValue(data.selectedCondition);
    end;
    if data.selectedStands then
        selectedStands = {};
        local standMap = {};
        for _, stand in ipairs(data.selectedStands) do
            table.insert(selectedStands, stand);
            for displayName, code in pairs(standNameMap) do
                if code == stand then
                    standMap[displayName] = true;
                end;
            end;
        end;
        l_Options_0.SelectStands:SetValue(standMap);
    end;
    if data.selectedAttris then
        selectedAttris = {};
        local attriMap = {};
        for _, attri in ipairs(data.selectedAttris) do
            table.insert(selectedAttris, attri);
            attriMap[attri] = true;
        end;
        l_Options_0.SelectAttributes:SetValue(attriMap);
    end;
    if data.specialReserve then
        for i = 1, 6 do
            local group = data.specialReserve[i];
            if group then
                specialReserveList[i].stand = group.stand or "";
                specialReserveList[i].attris = group.attris or {};
                if group.stand and group.stand ~= "" then
                    for displayName, code in pairs(standNameMap) do
                        if code == group.stand then
                            l_Options_0["SpecialStand_" .. i]:SetValue(displayName);
                        end;
                    end;
                else
                    l_Options_0["SpecialStand_" .. i]:SetValue(nil);
                end;
                local attriMap = {};
