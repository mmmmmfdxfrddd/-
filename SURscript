local function teleportPart(part, targetCFrame)
    if part and part:IsA("BasePart") then
        pcall(function()
            part.CFrame = targetCFrame;
            part.Velocity = Vector3.new(0, 0, 0);
        end);
    end;
end;

local function getCharacter()
    local char = l_LocalPlayer_0.Character or l_LocalPlayer_0.CharacterAdded:Wait();
    local hrp = char:WaitForChild("HumanoidRootPart", 3);
    local hum = char:WaitForChild("Humanoid", 3);
    if not hrp or not hum then return nil; end
    return char;
end;

local function fireRemote(remote, arg)
    return pcall(function()
        if arg ~= nil then
            remote:FireServer(arg);
        else
            remote:FireServer();
        end;
    end);
end;

local notifyLimiter = {};
local function notify(title, content, duration)
    local key = title .. content;
    local now = tick();
    if not notifyLimiter[key] then
        notifyLimiter[key] = { count = 0, resetTime = now + 60 };
    end;
    if now > notifyLimiter[key].resetTime then
        notifyLimiter[key] = { count = 0, resetTime = now + 60 };
    end;
    if notifyLimiter[key].count >= 2 then return; end;
    notifyLimiter[key].count = notifyLimiter[key].count + 1;
    v0:Notify({ Title = title, Content = content, Duration = duration or 5 });
end;

